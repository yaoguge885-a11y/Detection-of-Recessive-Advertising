    {
      "dot": "cyan",
      "title": "页面与数据契约",
      "items": [
        "POST /analyze 与 /analyze/batch 共用服务；GET /runs/{id} 恢复报告",
        "页面只读报告；OpenAPI → TypeScript，Zod 运行时校验",
        "evidence bundle 只读；失败保留 last-good，不覆盖旧结果"
      ]
    },
    {
      "dot": "rose",
      "title": "边界与取舍",
      "items": [
        "仅 127.0.0.1 同源；文本走 textContent，媒体经同源代理",
        "URL 先 preview 再 confirm；502 或超时明确报错，不伪造分数",
        "参考 EchoBreak 的仪表盘语言，不复制社区、后台、登录"
      ]
