# ============================================================
# 隐式广告识别智能体 (Implicit Ad Agent) 环境配置
# 复制此文件为 .env 并填入你的真实值
# ============================================================

# ---------- LLM 配置（必填）----------
# 支持 OpenAI / DeepSeek / 通义千问 等兼容端点
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---------- 本地广告判别模型（可选）----------
# pip install -e ".[text-model]"；仅加载本地二分类广告模型，不下载权重。
# 知乎模型尚未完成本平台校准，先通过同帖对照评测再启用。
# TEXT_INTENT_MODEL_PATH=D:/path/to/fine-tuned-ad-model
# 广告类的训练标签下标；现有知乎模型为 1。
TEXT_INTENT_POSITIVE_LABEL_ID=1

# ---------- LangSmith 追踪（可选）----------
# 用于调试和可视化 LangGraph 执行轨迹
# LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=implicit-ad-agent

# ---------- 脱敏采集 ----------
# 用于生成稳定但不可逆的匿名 ID
ANONYMIZATION_SALT=114514
